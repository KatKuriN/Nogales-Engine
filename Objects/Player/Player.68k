Player_Reset:
                move.b  #3,obj.Anim(a0)
                tst.w   play.LocalTimer(a0)
                beq.s   .Wait
                subq.w  #1,play.LocalTimer(a0)
                bne.s   .Wait
                move.w  #1,(restart).w

.Wait:
                rts

        include "Objects/Player/Player Animate.asm"
        include "Objects/Player/Player Dynamic GFX.asm"
