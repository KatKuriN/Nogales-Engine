; ---------------------------------------------------------------------------
; Type-00 Player Object code [play00]
; The code for Sonic's main player object
; ---------------------------------------------------------------------------
; local object variable struct
PLAYTILE = $780
play            struct
No:             dc.b 1
Render:         dc.b 1
Tile:           dc.w 1
Pat:            dc.l 1
X:              dc.w 1
YScr:           dc.w 1
Y:              dc.w 1
YSub:           dc.w 1
XSpeed:         dc.w 1
YSpeed:         dc.w 1
Momentum:       dc.w 1
YRad:           dc.b 1
XRad:           dc.b 1
XRender:        dc.b 1
Priority:       dc.b 1
Frame:          dc.b 1
AnimFrame:      dc.b 1
Anim:           dc.b 1
LastAnim:       dc.b 1
FrameTimer:     dc.b 1
FrameMirr:      dc.b 1
Collision:      dc.b 1
ColliCnt:       dc.b 1
Status:         dc.b 1
Respawn:        dc.b 1
Action:         dc.b 1
SubAction:      dc.b 1
Angle:          dc.w 1
Args:           dc.b 1
                dc.b 1
                dc.b 1
                dc.b 1
                dc.b 1
                dc.b 1
                dc.b 1
                dc.b 1
Timeout:        dc.w 1
Invincible:     dc.w 1                  
Speedup:        dc.w 1                  
FootFront:      dc.b 1                  
FootBack:       dc.b 1                  
YDeath:         dc.w 1                  
LocalTimer:     dc.w 1                  
Jump:           dc.b 1                  
OnObject:       dc.b 1                  
LockTime:       dc.b 1   
                ends


 ; ---------------------------------------------------------------------------

ObjPlayer:                  
;        tst.w   editMode.w      ; Load into editor object if enabled
;        bne.w   EditMode

        moveq   #0,d0
        move.b  obj.Action(a0),d0
        move.w  .Index(pc,d0.w),d1
        jmp     .Index(pc,d1.w)

; ---------------------------------------------------------------------------

.Index:                                          ; obj.Action:
                dc.w Player_Init-.Index          ; 0  
                dc.w Player_Main-.Index          ; 2
                dc.w Player_Reset-.Index         ; 4
                dc.w Player_Reset-.Index         ; 6
                dc.w Player_Reset-.Index         ; 8

; ---------------------------------------------------------------------------

Player_Init:                             
        addq.b  #2,obj.Action(a0)               
        move.b  #19,obj.YRad(a0)
        move.b  #9,obj.XRad(a0)         

        move.l  #SprPat_PlaySonic,obj.Pat(a0)
        move.w  #$780,obj.Tile(a0)

        move.b  #2,obj.Priority(a0)
        move.b  #24,obj.XRender(a0)      
        move.b  #%100,obj.Render(a0)    ; Draw based on playfield

        move.w  #$600,playerMaxSpeed.w  ; Reset player phys. deltas
        move.w  #18,playerAccel.w
        move.w  #24,playerDecel.w


Player_Main:                             
        andi.w  #$1FF,obj.Y(a0)         ; Clamp Y pos. to 256 pix. max        
        andi.w  #$1FF,cameraAPosY.w
        bsr.w   _objectSetSpeed
;        tst.w   debug.w                 ; Skip if debug enabled
;        beq.s   .Skip
;        btst    #4,joypadPressMirr.w    ; Turn on editor if B pressed
;        beq.s   .Skip
;
;        move.w  #1,editMode.w
;
;.Skip:                             
        moveq   #0,d0
        move.b  obj.Status(a0),d0       
        andi.w  #%00000110,d0           ; Use bits 1-2 as offset

        move.w  .PhysicsModes(pc,d0.w),d1
        jsr     .PhysicsModes(pc,d1.w)

        move.b  angleFront.w,play.FootFront(a0)
        move.b  angleBack.w,play.FootBack(a0)
        bsr.w   _playLevelLimits
        move.w  obj.Momentum(a0),d0
        bne.s   .Skip3
        move.b  #4,obj.Anim(a0)
        bra.s   .Skip2
.Skip3
        bpl.s   .Abs
        neg.w   d0
.Abs
        cmpi.w  #$600,d0
        bne.s   .NotMax
        move.b  #1,obj.Anim(a0)
        bra.s   .Skip2

.NotMax
        move.b  #0,obj.Anim(a0)
        asr.w   #7,d0
        eor.b   #$F,d0
        sub.b   #1,d0
        bcc.s   .Skip2
        moveq   #0,d0
.Skip2
        move.b  d0,frametimerOverride.w

        lea     AniSpr_Sonic,a1
        bsr.w   _objectAnimate          ; Handle Sonic's animation
        bsr.w   _playDynamicGFX         ; Handle dynamic GFX in VRAM
        bra.w   _objectDraw

; ---------------------------------------------------------------------------

.PhysicsModes:                                
                dc.w Player_MainCtrl-.PhysicsModes
                dc.w Player_AirCtrl-.PhysicsModes
                dc.w Player_RollCtrl-.PhysicsModes    
                dc.w Player_AirRollCtrl-.PhysicsModes

; ---------------------------------------------------------------------------
; Player physics routines
; See .PhysicsModes - each series of branches corresponds to obj.Status bits
; ---------------------------------------------------------------------------

Player_MainCtrl:                                 ; Status unset
        bsr.w   _playJumpChk
        bsr.w   _physUpSlope
        bsr.w   _playInputChk
        bsr.w   _playRollChk
 ;       bsr.w   _objectSetSpeed
        
        bsr.w   _physFootCollision
        bsr.w   _physChkFloorExit
        rts

Player_AirCtrl:                                  ; Status air bit set
        bsr.w   _playJumpHeight
        bsr.w   _playAirCtrl
        addi.w  #24,obj.YSpeed(a0)
;        bsr.w   _objectSetSpeed
        bsr.w   _playAirDir
        bsr.w   _physAirCollision
        rts

Player_RollCtrl:                                 ; Status roll bit set
        bsr.w   _playJumpChk
        bsr.w   _physRollDown
        bsr.w   _playRollCalc
;        bsr.w   _objectSetSpeed
        bsr.w   _physFootCollision
        bsr.w   _physChkFloorExit
        rts

Player_AirRollCtrl:                              ; Both statuses set
        bsr.w   _playJumpHeight
        bsr.w   _playAirCtrl
        addi.w  #24,obj.YSpeed(a0)
;        bsr.w   _objectSetSpeed
        bsr.w   _playAirDir
        bsr.w   _physAirCollision
        rts


; ---------------------------------------------------------------------------
; Main player movement function.
; Controls moving left and right, looking up and down, and misc.
; Note that this is a pretty large subroutine with a lot of locals. 
; ---------------------------------------------------------------------------

_playInputChk:                              
        move.w  playerMaxSpeed.w,d6     ; Set deltas to d4,d5,d6  
        move.w  playerAccel.w,d5
        move.w  playerDecel.w,d4

        tst.w   play.LockTime(a0)         ; If ctrl. locked, skip all this
        bne.w   .CalcSpeed

        btst    #2,joypad1Mirr.w         ; Skip if left input not pressed
        beq.s   .NotLeft
        bsr.w   _playMoveLeft

.NotLeft:                              
        btst    #3,joypad1Mirr.w         ; Skip if right input not pressed
        beq.s   .NotRight
        bsr.w   _playMoveRight

.NotRight:
        tst.w   obj.Momentum(a0)        ; If not moving
        bne.s   .Skip1
        move.b  #4,obj.Anim(a0)         ; Use idle animation
.Skip1 
        move.b  joypad1Mirr.w,d0
        andi.b  #%1100,d0               ; Skip if left or right pressed...
        bne.s   .CalcSpeed

        move.w  obj.Momentum(a0),d0     ; ...or if not moving
        beq.s   .CalcSpeed

        bmi.s   .MomentumNeg        ; Skip if negative momentum
        sub.w   d4,d0
        bcc.s   .StillMvPos         ; If it overflows down, clear
        move.w  #0,d0

.StillMvPos:                           
        move.w  d0,obj.Momentum(a0) ; Return new +momentum value
        bra.s   .CalcSpeed          ; Go set X+Y speeds based on this

.MomentumNeg:                          
        add.w   d4,d0
        bcc.s   .StillMvNeg         ; If it overflows up, clear   
        move.w  #0,d0

.StillMvNeg:                           
        move.w  d0,obj.Momentum(a0) ; Return new -momentum value

.CalcSpeed:                             
        move.b  obj.Angle(a0),d0    ; Get player angle input
        jsr     CalcSinCos          ; d0 = sin , d1 = cos

        muls.w  obj.Momentum(a0),d1 ; (momentum*cos) for X speed      
        asr.l   #8,d1               ; Divide by $100 (drop lowest byte)
        move.w  d1,obj.XSpeed(a0)

        muls.w  obj.Momentum(a0),d0 ; (momentum*sin) for Y speed 
        asr.l   #8,d0                
        move.w  d0,obj.YSpeed(a0)


        ; fall into _playHitWall

; ---------------------------------------------------------------------------
; Check if the player has hit a wall 
; ---------------------------------------------------------------------------

_playHitWall:                           
        move.b  #$40,d1             ; d1 = 90 degree push for calcs.
        tst.w   obj.Momentum(a0)    ; Exit if not moving
        beq.s   .Exit           

        bmi.s   .IsMvLeft
        neg.w   d1

.IsMvLeft:                             
        move.b  obj.Angle(a0),d0    ; Get angle
        add.b   d1,d0               ; Push it over 90 degrees

        move.w  d0,-(sp)    
        bsr.w   _physGetWallAhead
        move.w  (sp)+,d0

        tst.w   d1                  ; If dist. is +, we aren't hitting it
        bpl.s   .Exit

        move.w  #0,obj.Momentum(a0)         ; Clear momentum 
        bset    #PHYS.PUSH,obj.Status(a0)   ; Set as pushing against it

        asl.w   #8,d1
        addi.b  #$20,d0         ; Push angle 45 degrees for quadrants
        andi.b  #$C0,d0
        beq.s   .HitDwn
        cmpi.b  #$40,d0
        beq.s   .HitLeft
        cmpi.b  #$80,d0
        beq.s   .HitUp

.HitRight:
        add.w   d1,obj.XSpeed(a0)
        rts

.HitUp:                                
        sub.w   d1,obj.YSpeed(a0)
        rts

.HitLeft:                              
        sub.w   d1,obj.XSpeed(a0)
        rts

.HitDwn:                               
        add.w   d1,obj.YSpeed(a0)

.Exit:                                 
        rts

; ---------------------------------------------------------------------------
; Move player left
; ---------------------------------------------------------------------------

_playMoveLeft:                          
        move.w  obj.Momentum(a0),d0
        bpl.s   .Skidding

        bset    #PHYS.DIR,obj.Status(a0)
        bne.s   .FacingLeft

        bclr    #PHYS.PUSH,obj.Status(a0)

.FacingLeft:                           
        sub.w   d5,d0           ; Subtract acceleration delta
        move.w  d6,d1           ; Get negated max speed for leftwards chk.
        neg.w   d1              
        cmp.w   d1,d0           ; Check if met speed limit (d6)
        bgt.s   .BelowLimit
        move.w  d1,d0           ; Force as max speed if so

.BelowLimit:                           
        move.w  d0,obj.Momentum(a0)
        move.b  #0,obj.Anim(a0)         ; Set walking anim.
        rts

.Skidding:                             
        sub.w   d4,d0
        bcc.s   .StillMoving
        move.w  #-$80,d0

.StillMoving:                          
        move.w  d0,obj.Momentum(a0)     ; Get momentum w/ parity                                
        rts

; ---------------------------------------------------------------------------
; Move player right
; ---------------------------------------------------------------------------

_playMoveRight:                         
        move.w  obj.Momentum(a0),d0
        bmi.s   .Skidding

        bclr    #PHYS.DIR,obj.Status(a0)
        beq.s   .FacingRight

        bclr    #PHYS.PUSH,obj.Status(a0)
        move.b  #1,obj.LastAnim(a0)

.FacingRight:                          
        add.w   d5,d0           ; Add acceleration delta
        cmp.w   d6,d0           ; Check if met speed limit (d6)
        blt.s   .BelowLimit
        move.w  d6,d0           ; Force as max speed

.BelowLimit:                           
        move.w  d0,obj.Momentum(a0)    
        move.b  #0,obj.Anim(a0)
        rts

.Skidding:                             
        add.w   d4,d0
        bcc.s   .StillMoving
        move.w  #$80,d0

.StillMoving:                          
        move.w  d0,obj.Momentum(a0)     ; Get momentum w/ parity                               
        rts

; ---------------------------------------------------------------------------
; Player rolling
; ---------------------------------------------------------------------------

_playRollCalc:                          
        move.w  playerMaxSpeed.w,d6
        asl.w   #1,d6                   ; d6 = maxspeed/2
        move.w  playerAccel.w,d5
        asr.w   #1,d5                   ; d5 = acceleration/2
        move.w  playerDecel.w,d4
        asr.w   #2,d4                   ; d4 = deceleration/4

        tst.w   play.LockTime(a0)       ; If ctrl. locked, skip ctrl. code
        bne.s   .Settle

        btst    #2,joypad1Mirr.w
        beq.s   .CheckRight

        bsr.w   _playRollLeft

.CheckRight:                           
        btst    #3,joypad1Mirr.w
        beq.s   .Settle

        bsr.w   _playRollRight

.Settle:                               
        move.w  obj.Momentum(a0),d0
        beq.s   .CheckStop
        bmi.s   .SettleLeft

        sub.w   d5,d0
        bcc.s   .SetMomentum
        move.w  #0,d0

.SetMomentum:                          
        move.w  d0,obj.Momentum(a0)
        bra.s   .CheckStop

.SettleLeft:                           
        add.w   d5,d0
        bcc.s   .SetMomentum2
        move.w  #0,d0

.SetMomentum2:                         
        move.w  d0,obj.Momentum(a0)

.CheckStop:                            
        tst.w   obj.Momentum(a0)
        bne.s   .CalcSpeed

        bclr    #PHYS.ROLLING,obj.Status(a0)
        move.b  #19,obj.YRad(a0)
        move.b  #9,obj.XRad(a0)
        move.b  #4,obj.Anim(a0)
        subq.w  #5,obj.Y(a0)

.CalcSpeed:                            
        move.b  obj.Angle(a0),d0
        jsr     CalcSinCos
        muls.w  obj.Momentum(a0),d1
        asr.l   #8,d1
        move.w  d1,obj.XSpeed(a0)
        muls.w  obj.Momentum(a0),d0
        asr.l   #8,d0
        move.w  d0,obj.YSpeed(a0)
        bra.w   _playHitWall

; ---------------------------------------------------------------------------
; Player Roll Left
; ---------------------------------------------------------------------------

_playRollLeft:                          
        move.w  obj.Momentum(a0),d0
        beq.s   .StartRoll
        bpl.s   .Decelerate

.StartRoll:                            
        bset    #PHYS.DIR,obj.Status(a0)
        move.b  #2,obj.Anim(a0)
        rts

.Decelerate:                           
        sub.w   d4,d0
        bcc.s   .SetMomentum
        move.w  #-$80,d0

.SetMomentum:                          
        move.w  d0,obj.Momentum(a0)
        rts

; ---------------------------------------------------------------------------
; Player Roll Right
; ---------------------------------------------------------------------------

_playRollRight:                         
        move.w  obj.Momentum(a0),d0
        bmi.s   .Decelerate
        bclr    #0,obj.Status(a0)
        move.b  #2,obj.Anim(a0)
        rts

.Decelerate:                           
        add.w   d4,d0
        bcc.s   .SetMomentum
        move.w  #$80,d0

.SetMomentum:                          
        move.w  d0,obj.Momentum(a0)
        rts


; ---------------------------------------------------------------------------
; Airborne direction control
; ---------------------------------------------------------------------------

_playAirCtrl:                           
        move.w  playerMaxSpeed.w,d6
        move.w  playerAccel.w,d5
        asl.w   #1,d5
        btst    #PHYS.ROLLJUMP,obj.Status(a0)
        bne.s   .SetCamera
        move.w  obj.XSpeed(a0),d0
        btst    #2,joypad1.w
        beq.s   .NotLeft
;       bset    #PHYS.DIR,obj.Status(a0)
        sub.w   d5,d0
        move.w  d6,d1
        neg.w   d1
        cmp.w   d1,d0
        bgt.s   .NotLeft
        move.w  d1,d0

.NotLeft:                              
        btst    #3,joypad1.w
        beq.s   .SetSpeed
;       bclr    #PHYS.DIR,obj.Status(a0)
        add.w   d5,d0
        cmp.w   d6,d0
        blt.s   .SetSpeed
        move.w  d6,d0

.SetSpeed:                             
        move.w  d0,obj.XSpeed(a0)

.SetCamera:                            
        cmpi.w  #96,camACenterY.w
        beq.s   .CheckDrag
        bcc.s   .ShiftCam
        addq.w  #4,camACenterY.w

.ShiftCam:                             
        subq.w  #2,camACenterY.w

.CheckDrag:                            
        cmpi.w  #-$400,obj.YSpeed(a0)
        bcs.s   .Exit
        move.w  obj.XSpeed(a0),d0
        move.w  d0,d1
        asr.w   #5,d1
        beq.s   .Exit
        bmi.s   .MovingLeft
        sub.w   d1,d0
        bcc.s   .SetRAirDrag
        move.w  #0,d0

.SetRAirDrag:                          
        move.w  d0,obj.XSpeed(a0)
        rts

.MovingLeft:                           
        sub.w   d1,d0
        bcs.s   .SetLAirDrag
        move.w  #0,d0

.SetLAirDrag:                          
        move.w  d0,obj.XSpeed(a0)

.Exit:                                 
        rts

; ---------------------------------------------------------------------------
; Unused function, known as "hedcolchk" in source code
; ---------------------------------------------------------------------------
;
;_playHeadChk:
;        move.b  obj.Angle(a0),d0
;        addi.b  #$20,d0
;        andi.b  #$C0,d0
;        bne.s   .Exit
;        bsr.w   _physFootChkUp
;        tst.w   d1
;        bpl.s   .Exit
;        move.w  #0,obj.Momentum(a0)
;        move.w  #0,obj.XSpeed(a0)
;        move.w  #0,obj.YSpeed(a0)
;        move.b  #$B,obj.Anim(a0)
;
;.Exit:                                 
;        rts

; ---------------------------------------------------------------------------
; Function to prevent player from moving beyond camera/level limits
; ---------------------------------------------------------------------------
;
_playLevelLimits:                       
        move.l  obj.X(a0),d1
        move.w  obj.XSpeed(a0),d0
        ext.l   d0
        asl.l   #8,d0
        add.l   d0,d1
        swap    d1
        move.w  limitALeft.w,d0
        addi.w  #16,d0
        cmp.w   d1,d0
        bhi.s   .Reset

        move.w  limitARight.w,d0
        addi.w  #$128,d0
        cmp.w   d1,d0
        bls.s   .Reset

        move.w  limitADown.w,d0
        addi.w  #224,d0
        rts

.Reset:                                
        move.w  d0,obj.X(a0)
        move.w  #0,obj.YScr(a0)
        move.w  #0,obj.XSpeed(a0)
        move.w  #0,obj.Momentum(a0)
        move.w  cameraAPosX.w,limitALeft.w
        rts

; ---------------------------------------------------------------------------
; Function to check for rolling while walking/running
; ---------------------------------------------------------------------------

_playRollChk:                           
        move.w  obj.Momentum(a0),d0
        bpl.s   .AlreadyPositive
        neg.w   d0

.AlreadyPositive:                      
        cmpi.w  #$80,d0
        bcs.s   .Exit
        move.b  joypad1Mirr.w,d0
        andi.b  #%1100,d0               ; Leave if L or R are pressed
        bne.s   .Exit
        btst    #1,joypad1Mirr.w
        bne.s   _playRollSet

.Exit:                                 
        rts

; ---------------------------------------------------------------------------
; Function to set parameters for rolling (hitbox, animation, status, etc)
; ---------------------------------------------------------------------------

_playRollSet:                           
        btst    #PHYS.ROLLING,obj.Status(a0)
        beq.s   .DoRoll
        rts

.DoRoll:                               
        bset    #PHYS.ROLLING,obj.Status(a0)    

        move.b  #14,obj.YRad(a0)        ; New radiuses for rolling
        move.b  #7,obj.XRad(a0)

        move.b  #2,obj.Anim(a0)         ; Use rolling animation

        addq.w  #5,obj.Y(a0)            ; Nudge position upwards (bugfix?)

        move.w  #SFXNO_SPIN,d0          ; Play spin sound
        jsr     QueueSoundB

        tst.w   obj.Momentum(a0)        ; If momentum not 0, exit
        bne.s   .Exit                   

        move.w  #$200,obj.Momentum(a0)  ; Otherwise, nudge forward?

.Exit:                                 
        rts


; ---------------------------------------------------------------------------
; Function to check and set jumping
; ---------------------------------------------------------------------------

_playJumpChk:                           
        move.b  joypad1PressMirr.w,d0
        andi.b  #%1110000,d0
        beq.w   .Exit

        moveq   #0,d0
        move.b  obj.Angle(a0),d0
        addi.b  #$80,d0
        bsr.w   _physFootChk

        cmpi.w  #6,d1
        blt.w   .Exit

        moveq   #0,d0
        move.b  obj.Angle(a0),d0
        subi.b  #64,d0
        jsr     CalcSinCos
        muls.w  #$680,d1
        asr.l   #8,d1
        add.w   d1,obj.XSpeed(a0)
        
        muls.w  #$680,d0
        asr.l   #8,d0
        add.w   d0,obj.YSpeed(a0)

        bset    #PHYS.AIRBORNE,obj.Status(a0)   ; Set as airbourne,

        addq.l  #4,sp                           

        move.b  #1,play.Jump(a0)

        btst    #PHYS.ROLLING,obj.Status(a0)    ; If rolling already,
        bne.s   .RollJump                       ; skip to rolljump set


.Exit:                           
        rts

.RollJump:                             
        bset    #PHYS.ROLLJUMP,obj.Status(a0)
        rts

; ---------------------------------------------------------------------------
; Function to check held jump buttons and calculate jump height accordingly
; ---------------------------------------------------------------------------

_playJumpHeight:                        
        tst.b   play.Jump(a0)           ; If not jumping, leave
        beq.s   .NotJumping

        cmpi.w  #-$400,obj.YSpeed(a0)   ; If Y speed already set, hold
        bge.s   .HoldSpeed

        move.b  joypad1Mirr.w,d0         ; Check if A, C, or B held
        andi.b  #%1110000,d0            ; If so, hold speed
        bne.s   .HoldSpeed              
        move.w  #-$400,obj.YSpeed(a0)   ; Otherwise, set a low Y-speed

.HoldSpeed:                            
        rts

.NotJumping:                           
        cmpi.w  #-$FC0,obj.YSpeed(a0)           ; Cap upwards Y-speed
        bge.s   .Exit
        move.w  #-$FC0,obj.YSpeed(a0)

.Exit:                                 
        rts

; ---------------------------------------------------------------------------
; 
; ---------------------------------------------------------------------------

_physUpSlope:                           
        move.b  obj.Angle(a0),d0
        addi.b  #$60,d0 
        cmpi.b  #$C0,d0
        bcc.s   .Ceiling
        move.b  obj.Angle(a0),d0
        jsr     CalcSinCos
        muls.w  #128,d0
        asr.l   #8,d0
        tst.w   obj.Momentum(a0)
        beq.s   .Ceiling
        bmi.s   .MovingLeft
        tst.w   d0
        beq.s   .Exit
        add.w   d0,obj.Momentum(a0)

.Exit:                                 
        rts

.MovingLeft:                           
        add.w   d0,obj.Momentum(a0)

.Ceiling:                              
        rts


; ---------------------------------------------------------------------------
; 
; ---------------------------------------------------------------------------


_physRollDown:                          
        move.b  obj.Angle(a0),d0
        addi.b  #$60,d0
        cmpi.b  #$C0,d0
        bcc.s   .Exit
        move.b  obj.Angle(a0),d0
        jsr     (CalcSinCos).l
        muls.w  #128,d0
        asr.l   #8,d0
        tst.w   obj.Momentum(a0)
        bmi.s   .Left
        tst.w   d0
        bpl.s   .Positive
        asr.l   #2,d0

.Positive:                             
        add.w   d0,obj.Momentum(a0)
        rts

.Left:                                 
        tst.w   d0
        bmi.s   .Negative
        asr.l   #2,d0

.Negative:                             
        add.w   d0,obj.Momentum(a0)

.Exit:                                 
        rts

; ---------------------------------------------------------------------------
; 
; ---------------------------------------------------------------------------

_physChkFloorExit:                      
                nop
                tst.w   play.LockTime(a0)
                bne.s   .DecLockTimer
                move.b  obj.Angle(a0),d0
                addi.b  #$20,d0 ; ' '
                andi.b  #$C0,d0
                beq.s   .Exit
                move.w  obj.Momentum(a0),d0
                bpl.s   .NotNeg
                neg.w   d0

.NotNeg:                               
                cmpi.w  #640,d0
                bcc.s   .Exit
                bset    #PHYS.AIRBORNE,obj.Status(a0)
                move.w  #30,play.LockTime(a0)

.Exit:                                 
                rts

.DecLockTimer:                         
                subq.w  #1,play.LockTime(a0)
                rts

; ---------------------------------------------------------------------------
; 
; ---------------------------------------------------------------------------

_playAirDir:                            
        move.b  obj.Angle(a0),d0
        beq.s   .End
        bpl.s   .DecAngle
        addq.b  #2,d0
        bcc.s   .DoNotCap
        moveq   #0,d0

.DoNotCap:                             
        bra.s   .SetAngle

.DecAngle:                             
        subq.b  #2,d0
        bcc.s   .SetAngle
        moveq   #0,d0

.SetAngle:                             
        move.b  d0,obj.Angle(a0)

.End:                                  
        rts

; ---------------------------------------------------------------------------
; 
; ---------------------------------------------------------------------------

_physAirCollision:                      
        move.w  obj.XSpeed(a0),d1
        move.w  obj.YSpeed(a0),d2
        jsr     CalcATan
        subi.b  #$20,d0
        andi.b  #$C0,d0
        cmpi.b  #$40,d0
        beq.w   _physAirColLeft
        cmpi.b  #$80,d0
        beq.w   _physAirColUp
        cmpi.b  #$C0,d0
        beq.w   _physAirColRight


_physAirColDown:                        
        bsr.w   _physChkLeft
        tst.w   d1
        bpl.s   .WallNotLeft
        sub.w   d1,obj.X(a0)
        move.w  #0,obj.XSpeed(a0)

.WallNotLeft:                          
        bsr.w   _physChkRight
        tst.w   d1
        bpl.s   .WallNotRight
        add.w   d1,obj.X(a0)
        move.w  #0,obj.XSpeed(a0)

.WallNotRight:                         
        bsr.w   _physFootChkDown
        tst.w   d1
        bpl.s   .Exit
        move.b  obj.YSpeed(a0),d0
        addq.b  #8,d0
        neg.b   d0
        cmp.b   d0,d1
        blt.s   .Exit
        add.w   d1,obj.Y(a0)
        move.b  d3,obj.Angle(a0)
        bsr.w   _physAirExit
        move.b  #0,obj.Anim(a0)
        move.b  d3,d0
        addi.b  #$20,d0 ; ' '
        andi.b  #$40,d0 ; '@'
        bne.s   .LandFloor
        move.w  #0,obj.YSpeed(a0)
        move.w  obj.XSpeed(a0),obj.Momentum(a0)
        rts
; ---------------------------------------------------------------------------

.LandFloor:                            
        move.w  #0,obj.XSpeed(a0)
        cmpi.w  #$FC0,obj.YSpeed(a0)
        ble.s   .KeepYSpeed
        move.w  #$FC0,obj.YSpeed(a0)

.KeepYSpeed:                           
        move.w  obj.YSpeed(a0),obj.Momentum(a0)
        tst.b   d3
        bpl.s   .Exit
        neg.w   obj.Momentum(a0)

.Exit:                                 
        rts
; End of function _physAirColDown


; =============== S U B R O U T I N E =======================================


_physAirColLeft:                        
        bsr.w   _physChkLeft
        tst.w   d1
        bpl.s   loc_F11E
        sub.w   d1,obj.X(a0)
        move.w  #0,obj.XSpeed(a0)
        move.w  obj.YSpeed(a0),obj.Momentum(a0)
        rts
; ---------------------------------------------------------------------------

loc_F11E:                               
        bsr.w   _physFootChkUp
        tst.w   d1
        bpl.s   loc_F132
        sub.w   d1,obj.Y(a0)
        move.w  #0,obj.YSpeed(a0)
        rts
; ---------------------------------------------------------------------------

loc_F132:                               
        tst.w   obj.YSpeed(a0)
        bmi.s   locret_F15E
        bsr.w   _physFootChkDown
        tst.w   d1
        bpl.s   locret_F15E
        add.w   d1,obj.Y(a0)
        move.b  d3,obj.Angle(a0)
        bsr.w   _physAirExit
        move.b  #0,obj.Anim(a0)
        move.w  #0,obj.YSpeed(a0)
        move.w  obj.XSpeed(a0),obj.Momentum(a0)

locret_F15E:                            
        rts
; End of function _physAirColLeft


; =============== S U B R O U T I N E =======================================


_physAirColUp:                          
        bsr.w   _physChkLeft
        tst.w   d1
        bpl.s   loc_F172
        sub.w   d1,obj.X(a0)
        move.w  #0,obj.XSpeed(a0)

loc_F172:                               
        bsr.w   _physChkRight
        tst.w   d1
        bpl.s   loc_F184
        add.w   d1,obj.X(a0)
        move.w  #0,obj.XSpeed(a0)

loc_F184:                               
        bsr.w   _physFootChkUp
        tst.w   d1
        bpl.s   locret_F1BA
        sub.w   d1,obj.Y(a0)
        move.b  d3,d0
        addi.b  #$20,d0 ; ' '
        andi.b  #$40,d0 ; '@'
        bne.s   loc_F1A4
        move.w  #0,obj.YSpeed(a0)
        rts
; ---------------------------------------------------------------------------

loc_F1A4:                               
        move.b  d3,obj.Angle(a0)
        bsr.w   _physAirExit
        move.w  obj.YSpeed(a0),obj.Momentum(a0)
        tst.b   d3
        bpl.s   locret_F1BA
        neg.w   obj.Momentum(a0)

locret_F1BA:                            
        rts
; End of function _physAirColUp


; =============== S U B R O U T I N E =======================================


_physAirColRight:                       
        bsr.w   _physChkRight
        tst.w   d1
        bpl.s   loc_F1D6
        add.w   d1,obj.X(a0)
        move.w  #0,obj.XSpeed(a0)
        move.w  obj.YSpeed(a0),obj.Momentum(a0)
        rts
; ---------------------------------------------------------------------------

loc_F1D6:                               
        bsr.w   _physFootChkUp
        tst.w   d1
        bpl.s   loc_F1EA
        sub.w   d1,obj.Y(a0)
        move.w  #0,obj.YSpeed(a0)
        rts

; ---------------------------------------------------------------------------

loc_F1EA:                               
        tst.w   obj.YSpeed(a0)
        bmi.s   locret_F216
        bsr.w   _physFootChkDown
        tst.w   d1
        bpl.s   locret_F216
        add.w   d1,obj.Y(a0)
        move.b  d3,obj.Angle(a0)
        bsr.w   _physAirExit
        move.b  #0,obj.Anim(a0)
        move.w  #0,obj.YSpeed(a0)
        move.w  obj.XSpeed(a0),obj.Momentum(a0)

locret_F216:                            
        rts

; ---------------------------------------------------------------------------

_physAirExit:                           
                btst    #PHYS.ROLLJUMP,obj.Status(a0)
                beq.s   .UnkSkip
                nop
                nop
                nop

.UnkSkip:                              
                bclr    #PHYS.PUSH,obj.Status(a0)
                bclr    #PHYS.AIRBORNE,obj.Status(a0)
                bclr    #PHYS.ROLLJUMP,obj.Status(a0)
                btst    #PHYS.ROLLING,obj.Status(a0)
                beq.s   .NotRolling
                bclr    #PHYS.ROLLING,obj.Status(a0)
                move.b  #19,obj.YRad(a0)
                move.b  #9,obj.XRad(a0)
                move.b  #0,obj.Anim(a0)
                subq.w  #5,obj.Y(a0)

.NotRolling:                           
                move.w  #0,play.LockTime(a0)
                move.b  #0,play.Jump(a0)
                rts

