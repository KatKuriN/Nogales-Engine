ObjPlayerTest:                          
        moveq   #0,d0
        move.b  obj.Action(a0),d0
        move.w  .Index(pc,d0.w),d1
        jmp     .Index(pc,d1.w)
; ---------------------------------------------------------------------------
.Index:                                
        dc.w TestAnims_Init-.Index
        dc.w TestAnims_Do-.Index
        dc.w TestAnims_Delete-.Index
        dc.w TestAnims_Delete-.Index
; ---------------------------------------------------------------------------

TestAnims_Init:                         
        addq.b  #2,obj.Action(a0)
        move.b  #18,obj.YRad(a0)
        move.b  #9,obj.XRad(a0)
        move.l  #SprPat_Enemy,obj.Pat(a0)
        move.w  #ENEMY_GFX,obj.Tile(a0)
        move.b  #4,obj.Render(a0)
        move.b  #2,obj.Priority(a0)
        move.b  #1,obj.Frame(a0)

TestAnims_Do:                           
        bsr.w   _objectJoypadCtrl
        bsr.w   _playDynamicGFX
        jmp     _objectDraw
; ---------------------------------------------------------------------------

_objectJoypadCtrl:                      
        move.b  joypadMirr.w,d4
        move.w  obj.Y(a0),d2
        move.w  obj.X(a0),d3
        moveq   #1,d1
        btst    #0,d4
        beq.s   .NoUp
        sub.w   d1,d2

.NoUp:                                 
        btst    #1,d4
        beq.s   .NoDown
        add.w   d1,d2

.NoDown:                               
        btst    #2,d4
        beq.s   .NoLeft
        sub.w   d1,d3

.NoLeft:                               
        btst    #3,d4
        beq.s   .NoRight
        add.w   d1,d3

.NoRight:                              
        move.w  d2,obj.Y(a0)
        move.w  d3,obj.X(a0)
        btst    #4,joypadPressMirr.w
        beq.s   .NoB
        move.b  obj.Render(a0),d0
        move.b  d0,d1
        addq.b  #1,d0
        andi.b  #3,d0
        andi.b  #$FC,d1
        or.b    d1,d0
        move.b  d0,obj.Render(a0)

.NoB:                                  
        btst    #5,joypadPressMirr.w
        beq.s   .NoC
        addq.b  #1,obj.Frame(a0)
        cmpi.b  #6-1,obj.Frame(a0)
        bcs.s   .NoC
        move.b  #0,obj.Frame(a0)

.NoC:
        rts

; ---------------------------------------------------------------------------

TestAnims_Delete:                     
        jmp     _objectDelete 


ObjPlayerRef:
        tst.b   cameraManual.w
        beq.w   _objectDelete
        moveq   #0,d0
        move.b  obj.Action(a0),d0
        move.w  .Index(pc,d0.w),d1
        jmp     .Index(pc,d1.w)
; ---------------------------------------------------------------------------
.Index:                                
        dc.w RefFrame_Init-.Index
        dc.w RefFrame_Do-.Index
; ---------------------------------------------------------------------------
TILECNTMAX = 22

RefFrame_Init:
        addq.b  #2,obj.Action(a0)
        move.b  #18,obj.YRad(a0)
        move.b  #9,obj.XRad(a0)
        move.b  #24,obj.XRender(a0)
        move.l  #SprPat_PlaySonic,obj.Pat(a0)
        move.w  #$200,d1
        moveq   #0,d0
        move.b  obj.Args(a0),d0
        mulu.w  #TILECNTMAX,d0
        add.w   d0,d1
        move.w  d1,d4
        lsl.l   #5,d4
        move.w  d1,obj.Tile(a0)
        move.b  #4,obj.Render(a0)
        move.b  #2,obj.Priority(a0)
        move.b  obj.Args(a0),obj.Frame(a0)

                          
        moveq   #0,d0
        move.b  obj.Frame(a0),d0
        move.l  #ArtUnc_Sonic,d6
        lea     DynGfx_PlaySonic,a2

        ; im fucking lazy
        ; !!!TEMPORARY!!!

                add.w   d0,d0                   ; double ID (for word-based indexing)
                adda.w  (a2,d0.w),a2            ; find current DPLC entry
                moveq   #0,d5                   ; clear d5
                move.b  (a2)+,d5                ; get number of tasks in this DPLC entry
                subq.w  #1,d5                   ; subtract 1 from number of tasks (will be the loop count)
                bmi.w   .end                    ; if it underflowed, this is an empty entry, nothing to do
                
        .loop:
                move.b  (a2)+,d2                ; get first byte of DPLC task
                move.b  d2,-(sp)                ; move it to stack (bytes shift sp by 2)
                moveq   #0,d0                   ; clear d1
                move.w  (sp)+,d0                ; move it from stack to upper byte of d1
                move.b  (a2)+,d0                ; get second byte of DPLC task
                andi.w  #$F0,d2                 ; only look at upper nybble of first byte
                addi.w  #$10,d2                 ; add 1 to that nybble
                andi.w  #$FFF,d0                ; mask out that nybble in the other part
                lsl.l   #5,d0                   ; multiply by $20 (tile_size)
                add.l   d6,d0                   ; add art location
                move.w  d4,d1                   ; set target VRAM location
                add.w   d2,d4                   ; advance VRAM pointer
                add.w   d2,d4                   ; (twice, for word-based tiles)
                bsr.w   QueueDMA                ; load DMA request into queue (also known as "DMA_68KtoVRAM")
                dbf     d5,.loop                ; repeat for number of entries
                
        .end:
                rts                             ; return


RefFrame_Do:
        jmp     _objectDraw


; ---------------------------------------------------------------------------
; Process DMA queue entries (TEMPORARY)
; Call this in VBLANK...  probably. I guess.
; ---------------------------------------------------------------------------
dmaQueue = levelChunks+$A000
ProcessDMAQueue:
        lea     VDPCTRL,a4
        moveq   #0,d3
        move.w  #$8F02,VDPCTRL
        lea     dmaQueue.w,a1
        move.w  (a1)+,d7
        bra.s   .Skip           ; Skip ahead for dbf dec. adjustment
        
; ---------------------------------------------------------------------------

.BuildDMARegs: 
        lea     .DMARegs(pc),a0
        movem.w (a0),d0-d4
        addq.l  #6,a0

        ; Get size

        move.b  (a1)+,d1        ; Hi
        move.b  (a1)+,d0        ; Lo

        move.b  (a1)+,d4        ; Skip byte

        ; Get source addr.

        move.b  (a1)+,d4        ; Hi
        move.b  (a1)+,d3        ; Mid
        move.b  (a1)+,d2        ; Lo

        ; Make size regs. 

        move.w  d0,(a4)         ; Lo
        move.w  d1,(a4)         ; Hi

        ; Make src. regs.

        move.w  d2,(a4)         ; Lo            
        move.w  d3,(a4)         ; Mid
        move.w  d4,(a4)         ; Hi

        move.w  (a1)+,(a4)      ; Set VRAM dest. addr.
        move.w  (a1)+,d1        ; Get dest
        ori.w   #$80,d1         ; Set as DMA
        move.w  d1,-(sp)        ; Push
        move.w  (sp)+,(a4)      ; Set dest. 

        move.l  -(a1),d1        ; ----- DMA write fix
        move.w  d1,(a4)
        move.l  -(a1),d1
        add.l   d1,d1
        movea.l d1,a2
        move.w  (a2),-4(a4)
        addq.w  #8,a1

.Skip: 
        dbf     d7,.BuildDMARegs
        move.w  #0,Z80BUS
        clr.w   dmaQueue.w
        rts

; ---------------------------------------------------------------------------

.DMARegs:
        dc.w $9300      ; Size Lo
        dc.w $9400      ; Size Hi
        dc.w $9500      ; Src Lo
        dc.w $9600      ; Src Mid
        dc.w $9700      ; Src Hi

; ---------------------------------------------------------------------------

; ---------------------------------------------------------------------------
; Queue a DMA write
; ARGUMENTS:
;       d0 - Source addr.
;       d1 - VRAM address
;       d2 - Size in words
; ---------------------------------------------------------------------------


QueueDMA: 
        movem.l d3-a6,-(sp)
        moveq   #0,d3
        move.w  d2,d3
        add.w   d2,d3
        add.l   d0,d3
        eor.l   d0,d3
        btst    #17,d3
        beq.s   .CheckQueue
        movem.l (sp)+,d3-a6
        rts

.CheckQueue:
        moveq   #0,d3
        lea     dmaQueue.w,a0
        move.w  (a0)+,d3
        cmpi.w  #16,d3
        bcs.s   .Finish
        movem.l (sp)+,d3-a6
        rts

.IncrSlot:  
        adda.w  #$A,a0

.Finish: 
        dbf     d3,.IncrSlot
        move.w  d2,(a0)+
        andi.l  #$FFFFFF,d0
        lsr.l   #1,d0
        move.l  d0,(a0)+
        andi.l  #$FFFF,d1
        lsl.l   #2,d1
        lsr.w   #2,d1
        ori.w   #$4000,d1
        swap    d1
        move.l  d1,(a0)
        addq.w  #1,dmaQueue.w
        movem.l (sp)+,d3-a6
        rts